        <mxCell id="train_data" value="&lt;b&gt;Approved bilingual QA pairs&lt;/b&gt;&#xa;pair-grouped train / valid / test&#xa;zero pair overlap" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#5B3A00;strokeColor=#D97706;strokeWidth=2;fillColor=#FFF3E0;" vertex="1" parent="vector_layer"><mxGeometry x="75" y="860" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="train_format" value="&lt;b&gt;Training sequence&lt;/b&gt;&#xa;[instruction | question | answer]&#xa;No held-out RAG evidence leakage" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#5B3A00;strokeColor=#D97706;strokeWidth=2;fillColor=#FFF3E0;" vertex="1" parent="vector_layer"><mxGeometry x="385" y="860" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="train_llm" value="&lt;b&gt;Frozen 4-bit causal LLM&lt;/b&gt;&#xa;+ trainable LoRA A/B&#xa;Qwen or GLM, trained separately" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#374151;strokeColor=#E57200;strokeWidth=3;fillColor=#FFF8EF;" vertex="1" parent="vector_layer"><mxGeometry x="710" y="850" width="285" height="135" as="geometry"/></mxCell>
        <mxCell id="mask_prompt" value="Prompt tokens&#xa;&lt;b&gt;label = −100&lt;/b&gt;&#xa;m&lt;sub&gt;t&lt;/sub&gt; = 0" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=15;fontColor=#374151;strokeColor=#9CA3AF;strokeWidth=2;fillColor=#ECEFF3;" vertex="1" parent="vector_layer"><mxGeometry x="1045" y="850" width="170" height="95" as="geometry"/></mxCell>
        <mxCell id="mask_answer" value="Answer tokens&#xa;&lt;b&gt;supervised&lt;/b&gt;&#xa;m&lt;sub&gt;t&lt;/sub&gt; = 1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=15;fontColor=#8F3A00;strokeColor=#E57200;strokeWidth=2;fillColor=#FFD8B0;" vertex="1" parent="vector_layer"><mxGeometry x="1225" y="850" width="170" height="95" as="geometry"/></mxCell>
        <mxCell id="loss" value="&lt;b&gt;Completion-only objective&lt;/b&gt;&#xa;L = −Σ&lt;sub&gt;t&lt;/sub&gt; m&lt;sub&gt;t&lt;/sub&gt; log p&lt;sub&gt;θ&lt;/sub&gt;(y&lt;sub&gt;t&lt;/sub&gt; | x, y&lt;sub&gt;&amp;lt;t&lt;/sub&gt;)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=18;fontColor=#5B3A00;strokeColor=#D97706;strokeWidth=2;fillColor=#FFF3E0;" vertex="1" parent="vector_layer"><mxGeometry x="1440" y="850" width="310" height="95" as="geometry"/></mxCell>
        <mxCell id="grad_ab" value="&lt;b&gt;Backpropagation&lt;/b&gt;&#xa;gradients update A and B only&#xa;W₀ remains frozen" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#A94600;strokeColor=#E57200;strokeWidth=2;fillColor=#FFE8CF;" vertex="1" parent="vector_layer"><mxGeometry x="1270" y="1015" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="train_hparams" value="r = 64 · α = 16 · dropout = 0.05 · learning rate = 2×10⁻⁴ · one epoch · completion-only labels" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#7C4A13;strokeColor=none;fillColor=none;" vertex="1" parent="vector_layer"><mxGeometry x="310" y="1160" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="single_gpu_train" value="Resource-constrained PEFT training" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=15;fontStyle=1;fontColor=#374151;strokeColor=#4A5568;strokeWidth=2;fillColor=#EEF1F5;" vertex="1" parent="vector_layer"><mxGeometry x="75" y="1040" width="260" height="65" as="geometry"/></mxCell>
        <mxCell id="e_train1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#E57200;strokeWidth=2.5;" edge="1" parent="vector_layer" source="train_data" target="train_format"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_train2" value="teacher forcing" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#E57200;strokeWidth=2.5;labelBackgroundColor=#FFF9F2;fontFamily=Arial;fontSize=11;" edge="1" parent="vector_layer" source="train_format" target="train_llm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_train_mask1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#9CA3AF;strokeWidth=2;" edge="1" parent="vector_layer" source="train_llm" target="mask_prompt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_train_mask2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#E57200;strokeWidth=2.5;" edge="1" parent="vector_layer" source="mask_prompt" target="mask_answer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_train_loss" value="answer-token loss only" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#E57200;strokeWidth=2.5;labelBackgroundColor=#FFF9F2;fontFamily=Arial;fontSize=11;" edge="1" parent="vector_layer" source="mask_answer" target="loss"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_loss_grad" value="backward" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#E57200;strokeWidth=2.5;labelBackgroundColor=#FFF9F2;fontFamily=Arial;fontSize=11;" edge="1" parent="vector_layer" source="loss" target="grad_ab"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_grad_llm" value="A/B update only" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#E57200;strokeWidth=2.5;dashed=1;labelBackgroundColor=#FFF9F2;fontFamily=Arial;fontSize=11;" edge="1" parent="vector_layer" source="grad_ab" target="train_llm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="1065"/><mxPoint x="850" y="1065"/></Array></mxGeometry></mxCell>

        <!-- Main stage arrows -->
        <mxCell id="stage_arrow12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=2.5;" edge="1" parent="vector_layer"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="175" as="sourcePoint"/><mxPoint x="460" y="175" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="stage_arrow23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=2.5;" edge="1" parent="vector_layer"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="175" as="sourcePoint"/><mxPoint x="880" y="175" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="stage_arrow34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=2.5;" edge="1" parent="vector_layer"><mxGeometry relative="1" as="geometry"><mxPoint x="1270" y="175" as="sourcePoint"/><mxPoint x="1300" y="175" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="stage_arrow45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=2.5;" edge="1" parent="vector_layer"><mxGeometry relative="1" as="geometry"><mxPoint x="1800" y="175" as="sourcePoint"/><mxPoint x="1830" y="175" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="caption" value="&lt;b&gt;Figure X.&lt;/b&gt; Neural retrieval and completion-only QLoRA adaptation framework with governed bilingual evidence conditioning and independent evaluation dimensions." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#111827;strokeColor=none;fillColor=none;" vertex="1" parent="vector_layer"><mxGeometry x="240" y="1260" width="1920" height="48" as="geometry"/></mxCell>
        <mxCell id="legend_online" value="online inference / evidence flow" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#64748B;strokeColor=none;fillColor=none;" vertex="1" parent="vector_layer"><mxGeometry x="60" y="1230" width="210" height="24" as="geometry"/></mxCell>
        <mxCell id="legend_train" value="offline trainable QLoRA path" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#A94600;strokeColor=none;fillColor=none;" vertex="1" parent="vector_layer"><mxGeometry x="300" y="1230" width="210" height="24" as="geometry"/></mxCell>
        <mxCell id="legend_eval" value="dashed = evaluation-only or explanatory link" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#64748B;strokeColor=none;fillColor=none;" vertex="1" parent="vector_layer"><mxGeometry x="540" y="1230" width="300" height="24" as="geometry"/></mxCell>

        <!-- Hidden editing notes -->
        <mxCell id="note1" value="Do not reconnect the retrieval path to the offline QLoRA loss. Retrieval contexts are used in RAG inference; QLoRA training uses approved bilingual QA examples with pair-grouped splits." style="shape=note;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;strokeColor=#D97706;fillColor=#FFF3CD;" vertex="1" parent="notes_layer"><mxGeometry x="900" y="760" width="400" height="150" as="geometry"/></mxCell>
        <mxCell id="note2" value="RRF constant k₀ = 60. LoRA rank r = 64. These parameters are unrelated." style="shape=note;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;strokeColor=#D97706;fillColor=#FFF3CD;" vertex="1" parent="notes_layer"><mxGeometry x="950" y="500" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="note3" value="The original raster is embedded in the hidden reference layer. Toggle that layer to trace the source composition." style="shape=note;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;strokeColor=#7B61A8;fillColor=#F4ECFA;" vertex="1" parent="notes_layer"><mxGeometry x="40" y="40" width="360" height="110" as="geometry"/></mxCell>
