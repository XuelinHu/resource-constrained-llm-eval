        <mxCell id="metric_resource" value="&lt;b&gt;Resource-constrained inference&lt;/b&gt;&#xa;latency · peak GPU memory · tokens/s" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=15;fontColor=#374151;strokeColor=#6B7280;strokeWidth=2;fillColor=#F3F4F6;" vertex="1" parent="vector_layer"><mxGeometry x="1900" y="770" width="390" height="48" as="geometry"/></mxCell>
