        <mxCell id="trade_title" value="&lt;b&gt;Empirical trade-off (schematic)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#8F3A00;strokeColor=none;fillColor=none;" vertex="1" parent="vector_layer"><mxGeometry x="1910" y="880" width="370" height="35" as="geometry"/></mxCell>
        <mxCell id="trade_qa" value="&lt;b&gt;QLoRA&lt;/b&gt;&#xa;Domain QA ↑&#xa;answer overlap ↑" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=17;fontColor=#14532D;strokeColor=#168C50;strokeWidth=2;fillColor=#EAF7EF;" vertex="1" parent="vector_layer"><mxGeometry x="1910" y="935" width="175" height="105" as="geometry"/></mxCell>
        <mxCell id="trade_cite" value="Citation-format&#xa;compliance may ↓&#xa;translation: task/direction dependent" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontFamily=Arial;fontSize=16;fontColor=#9B1C1C;strokeColor=#C65353;strokeWidth=2;fillColor=#FFF3F3;" vertex="1" parent="vector_layer"><mxGeometry x="2105" y="935" width="175" height="105" as="geometry"/></mxCell>
        <mxCell id="trade_note" value="Hybrid RAG and QLoRA are complementary for answer overlap, but benefits are not monotonic across objectives." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontStyle=2;fontColor=#64748B;strokeColor=none;fillColor=none;" vertex="1" parent="vector_layer"><mxGeometry x="1910" y="1048" width="370" height="30" as="geometry"/></mxCell>
